<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lodestar report &#8212; {{ run.id }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Newsreader:ital,opsz@1,6..72&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;450;500&display=swap" rel="stylesheet">
  <style>
    *{ box-sizing:border-box; }
    html,body{ margin:0; }

    /* ---- tokens: light is the default, dark follows the device with no toggle ---- */
    :root{
      --display:'Source Serif 4',Georgia,serif;
      --italic:'Newsreader',Georgia,serif;
      --body:'Inter',ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;
      --mono:'IBM Plex Mono',ui-monospace,monospace;

      --paper:#f4f2ec; --raise:#faf9f5; --card:#fff; --ink:#1b1915; --ink-2:#54504a; --ink-3:#8a857c;
      --line:#e4e0d6; --line-2:#efece4; --gold:#9a7b1e; --gold-wash:#f3ebd4; --pos:#3f6b50;
      --shadow:0 1px 2px rgba(27,25,21,.04),0 8px 24px rgba(27,25,21,.05);
    }
    @media (prefers-color-scheme: dark){
      :root{
        --paper:#100f0c; --raise:#16150f; --card:#1a1813; --ink:#f1efe6; --ink-2:#b3aea2; --ink-3:#7d786d;
        --line:#2a271f; --line-2:#201e17; --gold:#e3c163; --gold-wash:#241f10; --pos:#83b395;
        --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 28px rgba(0,0,0,.35);
      }
    }

    body{
      background:var(--paper); color:var(--ink); font-family:var(--body); font-size:15px; line-height:1.6;
      font-variant-numeric:tabular-nums; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
    }

    /* ---- top bar + tabs ---- */
    .topbar{ position:sticky; top:0; z-index:40; background:color-mix(in srgb, var(--paper) 86%, transparent); backdrop-filter:saturate(1.4) blur(10px); border-bottom:1px solid var(--line); }
    .topbar-inner{ max-width:1080px; margin:0 auto; padding:16px 28px; display:flex; align-items:center; gap:18px; }
    .brand{ display:flex; align-items:baseline; gap:9px; font:600 16px/1 var(--display); letter-spacing:.01em; }
    .brand .star{ color:var(--gold); font-size:15px; transform:translateY(1px); }
    .runmeta{ margin-left:auto; font:11px/1.5 var(--mono); color:var(--ink-3); letter-spacing:.02em; text-align:right; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .runmeta b{ color:var(--ink-2); font-weight:500; }

    .tabs{ max-width:1080px; margin:0 auto; padding:0 28px; display:flex; gap:4px; overflow-x:auto; scrollbar-width:none; }
    .tabs::-webkit-scrollbar{ display:none; }
    .tab{ appearance:none; background:none; border:none; cursor:pointer; font:450 13.5px/1 var(--body); color:var(--ink-3); padding:13px 12px; position:relative; white-space:nowrap; border-bottom:2px solid transparent; margin-bottom:-1px; }
    .tab:hover{ color:var(--ink-2); }
    .tab.on{ color:var(--ink); border-bottom-color:var(--gold); }
    .tab:focus-visible{ outline:2px solid var(--gold); outline-offset:-4px; border-radius:4px; }

    /* ---- layout ---- */
    main{ max-width:1080px; margin:0 auto; padding:0 28px 120px; }
    .view{ display:none; }
    .view.on{ display:block; animation:rise .32s ease both; }
    @keyframes rise{ from{ opacity:0; transform:translateY(6px); } to{ opacity:1; transform:none; } }
    @media (prefers-reduced-motion: reduce){ .view.on{ animation:none; } }

    .eyebrow{ font:500 11px/1 var(--mono); letter-spacing:.18em; text-transform:uppercase; color:var(--gold); }
    .block{ padding-top:40px; }
    .block + .block{ margin-top:40px; border-top:1px solid var(--line); }
    .block-h{ display:flex; align-items:baseline; gap:14px; flex-wrap:wrap; margin-bottom:6px; }
    .block-h h2{ font:600 21px/1.2 var(--display); margin:0; letter-spacing:-.01em; }
    .lede{ margin:8px 0 24px; color:var(--ink-2); max-width:62ch; }
    .muted{ color:var(--ink-3); }

    /* ---- overview: thesis + three figures + quiet meta ---- */
    .hero{ padding:52px 0 8px; }
    .hero .title{ font:600 clamp(38px,6vw,64px)/1.02 var(--display); letter-spacing:-.025em; margin:18px 0 0; }
    .hero .title .lit{ font-family:var(--italic); font-style:italic; font-weight:400; color:var(--gold); }
    .hero .subtitle{ margin:14px 0 0; font:13px/1 var(--mono); letter-spacing:.04em; color:var(--ink-3); }
    .figures{ display:flex; flex-wrap:wrap; gap:14px 56px; margin:40px 0 30px; }
    .fig{ display:flex; flex-direction:column; gap:6px; }
    .fig .n{ font:600 44px/.9 var(--display); letter-spacing:-.02em; }
    .fig.signal .n{ color:var(--gold); }
    .fig .l{ font:11px/1.3 var(--mono); letter-spacing:.05em; text-transform:uppercase; color:var(--ink-3); }
    .fig .sub{ font:12px/1 var(--mono); color:var(--ink-2); }
    .metastrip{ display:flex; flex-wrap:wrap; gap:8px 26px; padding:18px 0 0; border-top:1px solid var(--line); font:12px/1.4 var(--mono); color:var(--ink-2); }
    .metastrip .k{ color:var(--ink-3); }
    .manifest-line{ margin-top:24px; font:11px/1.7 var(--mono); color:var(--ink-3); letter-spacing:.02em; }

    /* ---- cards / charts ---- */
    .surface{ background:var(--card); border:1px solid var(--line); border-radius:14px; padding:22px; box-shadow:var(--shadow); }
    svg{ display:block; width:100%; height:auto; }

    .statline{ display:flex; flex-wrap:wrap; gap:6px 32px; margin-top:18px; font:12px/1 var(--mono); color:var(--ink); padding-left:16px; border-left:2px solid var(--gold); }
    .statline .lbl{ color:var(--ink-3); margin-right:6px; }

    /* ---- tables ---- */
    table{ width:100%; border-collapse:collapse; font-size:13.5px; margin-top:6px; }
    th{ text-align:right; font:500 10px/1.4 var(--mono); letter-spacing:.06em; text-transform:uppercase; color:var(--ink-3); padding:0 0 10px 16px; border-bottom:1px solid var(--line); white-space:nowrap; }
    td{ text-align:right; padding:12px 0 12px 16px; border-bottom:1px solid var(--line-2); vertical-align:top; }
    th:first-child, td:first-child{ text-align:left; padding-left:0; }
    td:first-child{ font:12.5px/1.4 var(--mono); color:var(--ink-2); }
    tr.is-optimal td{ background:var(--gold-wash); }
    tr.is-optimal td:first-child{ color:var(--ink); font-weight:600; box-shadow:inset 2px 0 0 var(--gold); padding-left:10px; }
    tr.is-row-highlighted{ outline:2px solid var(--gold); outline-offset:-2px; }
    .caption{ margin:0 0 12px; font:12px/1.5 var(--mono); color:var(--ink-3); }

    /* SES inline bar -- neutral, gold is reserved for the lodestar signal only */
    .ses-bar{ display:flex; align-items:center; gap:10px; }
    .ses-bar .track{ flex:1; height:6px; background:var(--line-2); border-radius:3px; overflow:hidden; }
    .ses-bar .fill{ height:100%; background:var(--ink-3); border-radius:3px; }
    .ses-bar .val{ width:34px; text-align:right; }

    /* ---- validation ---- */
    .vgrid{ display:grid; grid-template-columns:1fr; gap:28px; }
    .vgrid.two{ grid-template-columns:1.4fr 1fr; align-items:start; }
    @media (max-width:760px){ .vgrid.two{ grid-template-columns:1fr; } }
    .headline-stat{ display:flex; flex-wrap:wrap; align-items:baseline; gap:6px 18px; border-left:2px solid var(--gold); padding:4px 0 4px 18px; margin:6px 0 26px; }
    .headline-stat .big{ font:600 38px/1 var(--display); letter-spacing:-.01em; }

    /* ---- cross-lingual heatmap ---- */
    .heat{ display:grid; grid-template-columns:120px repeat(4,1fr); gap:4px; border:1px solid var(--line); border-radius:12px; padding:6px; background:var(--card); }
    .lodestar-cell{ position:relative; min-height:52px; display:flex; align-items:center; justify-content:center; font:13px/1 var(--mono); font-variant-numeric:tabular-nums; border-radius:7px; overflow:hidden; outline:2px solid transparent; outline-offset:-2px; }
    /* inline style sets outline:transparent per cell (lodestar_svg.py) -- needs !important to win on hover */
    .lodestar-cell:hover{ outline:2px solid var(--gold) !important; }
    .field-label{ font:10px/1 var(--mono); letter-spacing:.08em; text-transform:uppercase; color:var(--ink-3); margin-bottom:12px; }
    .note{ margin-top:18px; padding:14px 16px; background:var(--raise); border:1px solid var(--line); border-radius:10px; color:var(--ink-2); font-size:13.5px; }

    /* ---- generations drill ---- */
    .toolbar{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin:18px 0 14px; }
    .chips{ display:flex; gap:6px; flex-wrap:wrap; }
    .chip{ appearance:none; cursor:pointer; font:12px/1 var(--mono); letter-spacing:.02em; text-transform:capitalize; padding:7px 13px; border-radius:999px; background:transparent; color:var(--ink-2); border:1px solid var(--line); }
    .chip:hover{ border-color:var(--ink-3); }
    .chip.on{ background:var(--ink); color:var(--paper); border-color:var(--ink); }
    .search{ flex:1; min-width:200px; padding:11px 14px; border:1px solid var(--line); border-radius:10px; background:var(--card); color:var(--ink); font:13.5px var(--body); outline:none; box-sizing:border-box; }
    .search:focus{ border-color:var(--ink-3); }
    .count{ font:11px/1 var(--mono); color:var(--ink-3); white-space:nowrap; }

    .rows{ border:1px solid var(--line); border-radius:12px; overflow:hidden; background:var(--card); }
    .row{ border-bottom:1px solid var(--line-2); }
    .row:last-child{ border-bottom:none; }
    .row.hide{ display:none; }
    .row.is-row-highlighted .row-h{ background:var(--gold-wash); }
    .row-h{ display:grid; grid-template-columns:74px 1fr auto 16px; align-items:center; gap:14px; padding:13px 16px; cursor:pointer; }
    .row-h:hover{ background:var(--raise); }
    .cond{ font:10px/1 var(--mono); letter-spacing:.04em; text-transform:uppercase; text-align:center; padding:4px 0; border-radius:6px; color:var(--ink-2); background:var(--line-2); }
    .cond.steered{ color:var(--gold); background:var(--gold-wash); }
    .prompt{ font-size:13.5px; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .scores{ display:flex; gap:16px; font:11px/1 var(--mono); color:var(--ink-3); }
    .scores b{ color:var(--ink); font-weight:600; }
    .chev{ color:var(--ink-3); font-size:11px; transition:transform .18s ease; }
    .row.is-open .chev{ transform:rotate(90deg); }
    @media (prefers-reduced-motion: reduce){ .chev{ transition:none; } }
    .detail{ display:none; padding:4px 16px 22px; background:var(--raise); flex-direction:column; gap:16px; }
    .row.is-open .detail{ display:flex; }
    .detail .meta{ font:11px/1 var(--mono); color:var(--ink-3); }
    .gen-text{ font-size:13.5px; line-height:1.7; white-space:pre-wrap; max-height:280px; overflow:auto; background:var(--card); border:1px solid var(--line); border-radius:8px; padding:14px 16px; }
    .rubrics{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:8px 24px; }
    .rubric{ display:flex; justify-content:space-between; border-bottom:1px solid var(--line-2); padding-bottom:6px; }
    .rubric .k{ font:11px/1 var(--mono); color:var(--ink-3); }
    .rationale{ color:var(--ink-2); font-size:13px; line-height:1.6; }

    /* ---- click-to-inspect: frontier point -> Generations, filtered to that scale ---- */
    .lodestar-point{ cursor:pointer; }
    .lodestar-point.is-active circle:nth-child(2){ stroke:var(--gold); stroke-width:2; }
    .inspector{ display:none; align-items:center; gap:14px; flex-wrap:wrap; background:var(--gold-wash); border:1px solid var(--gold); border-radius:10px; padding:12px 16px; margin:0 0 14px; font:12px/1 var(--mono); color:var(--ink); }
    .inspector .label{ font-weight:600; }
    .inspector .pos{ color:var(--ink-2); }
    .inspector .spacer{ flex:1; }
    .inspector button{ font:11px/1 var(--mono); background:var(--card); border:1px solid var(--line); border-radius:6px; padding:6px 11px; cursor:pointer; color:var(--ink); }
    .inspector button:hover{ border-color:var(--gold); }

    /* ---- export ---- */
    .btnrow{ display:flex; gap:12px; flex-wrap:wrap; margin-top:6px; }
    .btn{ font:12px/1 var(--mono); padding:11px 16px; border:1px solid var(--line); border-radius:10px; background:var(--card); color:var(--ink); cursor:pointer; text-decoration:none; display:inline-flex; gap:8px; align-items:center; }
    .btn:hover{ border-color:var(--ink-3); }
    pre.json{ margin-top:18px; padding:16px; background:var(--card); border:1px solid var(--line); border-radius:10px; font:12px/1.6 var(--mono); color:var(--ink-2); overflow:auto; }

    footer{ max-width:1080px; margin:40px auto 0; padding:22px 28px 0; border-top:1px solid var(--line); color:var(--ink-3); font:11px/1.7 var(--mono); }

    /* ---- tooltip ---- */
    .tip{ position:fixed; z-index:60; pointer-events:none; display:none; max-width:260px; background:var(--card); border:1px solid var(--line); border-radius:8px; padding:8px 11px; font:11px/1.5 var(--mono); color:var(--ink); box-shadow:var(--shadow); }
    .tip .l2{ color:var(--ink-3); }

    @media (max-width:640px){
      .topbar-inner{ flex-wrap:wrap; }
      .runmeta{ margin-left:0; text-align:left; white-space:normal; }
      .row-h{ grid-template-columns:64px 1fr 16px; }
      .scores{ display:none; }
    }
  </style>
</head>
<body>

<div class="tip" id="tip"><div class="l1"></div><div class="l2"></div></div>

<header class="topbar">
  <div class="topbar-inner">
    <span class="brand"><span class="star">&#10022;</span> Lodestar</span>
    <span class="runmeta">
      <b>{{ target_concept }}</b>{% if model_name %} &#183; {{ model_name }}{% endif %}{% if feature_label %} &#183; SAE {{ feature_label }}{% endif %}<br>
      {{ run.id[:8] }} &#183; {{ run.judge_model }} &#183; {{ run.n_repeats }} repeats &#183; ${{ "%.2f"|format(run.manifest.total_cost_usd) }}
    </span>
  </div>
  <nav class="tabs" id="tabs">
    {% for item in nav_items %}
    <button class="tab{% if loop.first %} on{% endif %}" data-v="{{ item.id }}" type="button">{{ item.label }}</button>
    {% endfor %}
  </nav>
</header>

<main>

  <!-- OVERVIEW -->
  <section class="view on" data-v="overview">
    <div class="hero">
      <span class="eyebrow">Concept-steering evaluation</span>
      <h1 class="title">Steering toward <span class="lit">{{ target_concept }}</span></h1>
      <p class="subtitle">
        {% if feature_label %}feature {{ feature_label }} &#183; {% endif %}{{ num_languages }} language{{ "s" if num_languages != 1 }} &#183; {{ drilldown_rows|map(attribute="model")|unique|list|length }} model{{ "s" if (drilldown_rows|map(attribute="model")|unique|list|length) != 1 }}{% if sections.human_validation %} &#183; human-validated{% endif %}
      </p>

      <div class="figures">
        <div class="fig signal">
          <span class="n">{{ optimal_scale_display }}</span>
          <span class="l">Optimal clamp scale</span>
          <span class="sub">the lodestar</span>
        </div>
        <div class="fig">
          <span class="n">{{ peak_ses_display }}</span>
          <span class="l">Peak SES</span>
          <span class="sub">relevance &#215; coherence/10</span>
        </div>
        <div class="fig">
          <span class="n">{{ control_gap_display }}</span>
          <span class="l">Control gap &#916;</span>
          <span class="sub">{% if control_stats %}95% CI {{ control_stats.ci }}{% else %}vs. random control{% endif %}</span>
        </div>
      </div>

      <div class="metastrip">
        <span><span class="k">Generations</span> {{ generation_count }}</span>
        <span><span class="k">Configs swept</span> {{ configs_swept }}</span>
        <span><span class="k">Consistency &#945;</span> {{ consistency_alpha_display }}</span>
        <span><span class="k">Judge &#961; vs human</span> {{ judge_rho_display }}</span>
        <span><span class="k">Models</span> {{ drilldown_rows|map(attribute="model")|unique|list|length }}</span>
        <span><span class="k">Languages</span> {{ num_languages }}</span>
      </div>
      <p class="manifest-line">
        JUDGE {{ run.judge_model }} &#183; TOOL {{ run.manifest.tool_version }} &#183; ELAPSED {{ "%.1f"|format(run.manifest.elapsed_seconds) }}s &#183; {{ run.manifest.cache_hits }} CACHE HITS &#183; TOTAL ${{ "%.2f"|format(run.manifest.total_cost_usd) }}
      </p>
    </div>
  </section>

  <!-- FRONTIER -->
  {% if sections.frontier or sections.control_gap %}
  <section class="view" data-v="frontier">
    {% if sections.frontier %}
    <div class="block">
      <div class="block-h"><span class="eyebrow">Navigate the trade-off</span><h2>Coherence&#8211;relevance frontier</h2></div>
      <p class="lede">Each point is one clamp scale. Pushing harder buys concept relevance at the cost of coherence; the shaded region satisfies the objective. The ringed point is the lodestar &#8212; the optimal operating scale. <span style="color:var(--gold)">Click any point to inspect its generations.</span></p>
      <div class="surface">{{ frontier_svg|safe }}</div>
      {{ frontier_table|safe }}
    </div>
    {% endif %}
    {% if sections.control_gap %}
    <div class="block">
      <div class="block-h"><span class="eyebrow">Against a random control</span><h2>Control gap</h2></div>
      <p class="lede">Concept relevance at the lodestar scale, steered versus a random-feature control. Whiskers are bootstrap 95% confidence intervals.</p>
      <div class="surface">{{ control_svg|safe }}</div>
      {% if control_stats %}
      <div class="statline">
        <span><span class="lbl">&#916; relevance</span> {{ control_stats.delta }}</span>
        <span><span class="lbl">95% CI</span> {{ control_stats.ci }}</span>
        <span><span class="lbl">Mann&#8211;Whitney U</span> {{ control_stats.p }}</span>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- CONFIGURATIONS -->
  {% if sections.configurations %}
  <section class="view" data-v="configurations">
    {% if sections.optimal %}
    <div class="block">
      <div class="block-h"><span class="eyebrow">Find your lodestar</span><h2>Optimal operating points</h2></div>
      <p class="caption">objective &nbsp; {{ objective }}</p>
      {{ optimal_table|safe }}
      <p class="caption" style="margin-top:18px">objective evaluated per language &#183; lodestar scale held at {{ optimal_scale_display }}</p>
    </div>
    {% endif %}
    {% if sections.cross_lingual %}
    <div class="block">
      <div class="block-h"><span class="eyebrow">Across languages</span><h2>Cross-lingual matrix</h2></div>
      <p class="lede">Scores at each language's optimal scale. Transfer is relevance relative to the source language. Cell shading scales with the column.</p>
      <div class="surface" style="padding:6px">{{ language_grid|safe }}</div>
    </div>
    {% endif %}
    {% if sections.cross_model %}
    <div class="block">
      <div class="block-h"><span class="eyebrow">Across models</span><h2>Cross-model comparison</h2></div>
      <p class="lede">Same rubrics and objective, each model at its own optimal scale. The SES bar is scaled to the strongest model.</p>
      {{ model_table|safe }}
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- VALIDATION -->
  {% if sections.validation %}
  <section class="view" data-v="validation">
    <div class="block">
      <div class="block-h"><span class="eyebrow">Calibrate the judge</span><h2>Judge validation</h2></div>
      {% if sections.human_validation and judge_rho_headline %}
      <div class="headline-stat">
        <span class="big">&#961; = {{ judge_rho_headline.rho }}</span>
        <span class="muted">Spearman correlation, judge vs. human annotators &#183; n&#8201;=&#8201;{{ judge_rho_headline.n }} &#183; {{ judge_rho_headline.p }}</span>
      </div>
      {% endif %}
      <div class="vgrid{% if sections.reliability and sections.human_validation and human_chart %} two{% endif %}">
        {% if sections.reliability %}
        <div>
          <div class="field-label">Self-consistency (k = {{ run.n_repeats }})</div>
          {{ reliability_table|safe }}
        </div>
        {% endif %}
        {% if sections.human_validation and human_chart %}
        <div>
          <div class="field-label">Judge vs. human (dotted = perfect calibration)</div>
          <div class="surface">{{ human_chart|safe }}</div>
        </div>
        {% endif %}
      </div>
      {% if sections.human_validation and human_table %}
      <div class="field-label" style="margin-top:28px">Per-rubric correlation</div>
      {{ human_table|safe }}
      {% endif %}
      {% if not sections.human_validation %}
      <p class="muted">No human labels supplied. Export a stratified labeling sheet with <code>lodestar validate</code>.</p>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <!-- CUSTOM METRICS -->
  {% if sections.custom_metrics %}
  <section class="view" data-v="custom">
    <div class="block">
      <div class="block-h"><span class="eyebrow">Beyond the six built-ins</span><h2>Custom metrics</h2></div>
      <p class="lede">Registered via <code>register_metric()</code> under a name of its own -- rendered generically since there's no dedicated chart for an unknown shape.</p>
      {% for name, table in custom_metric_tables.items() %}
      <div class="field-label" style="margin-top:20px">{{ name }}</div>
      {{ table|safe }}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- GENERATIONS -->
  <section class="view" data-v="generations">
    <div class="block">
      <div class="block-h"><span class="eyebrow">Inspect each generation</span><h2>Generations</h2></div>
      <p class="lede">Every aggregate above traces to these judged texts. Filter by condition or search the prompts, generations, and scores.</p>
      <div class="inspector" id="inspector">
        <span class="label" id="inspectorLabel"></span>
        <span class="pos" id="inspectorPos"></span>
        <span class="spacer"></span>
        <button type="button" id="inspectorPrev">&#8592; Prev</button>
        <button type="button" id="inspectorNext">Next &#8594;</button>
        <button type="button" id="inspectorClose">&#10005; Clear</button>
      </div>
      <div class="toolbar">
        <div class="chips" id="chips">
          <button class="chip on" data-c="all" type="button">All</button>
          {% for cond in drilldown_conditions %}
          <button class="chip" data-c="{{ cond }}" type="button">{{ cond }}</button>
          {% endfor %}
        </div>
        <input class="search" id="search" type="search" placeholder="Filter prompts, text, scores&#8230;">
        <span class="count" id="count">{{ drilldown_rows|length }} shown</span>
      </div>
      <div class="rows" id="rows">
        {% for row in drilldown_rows %}
        <div class="row" data-cond="{{ row.condition }}" data-scale="{{ row.scale }}">
          <div class="row-h">
            <span class="cond {{ row.condition }}">{{ row.condition }}</span>
            <span class="prompt">{{ row.prompt }}</span>
            <span class="scores"><span>COH <b>{{ row.coherence }}</b></span><span>REL <b>{{ row.relevance }}</b></span><span>SES <b>{{ row.ses }}</b></span></span>
            <span class="chev">&#9656;</span>
          </div>
          <div class="detail">
            <div class="meta">SCALE {{ row.scale }} &#183; LANG {{ row.language }} &#183; MODEL {{ row.model }} &#183; ID {{ row.id }}</div>
            <div>
              <div class="field-label">Generated text</div>
              <div class="gen-text">{{ row.text }}</div>
            </div>
            <div>
              <div class="field-label">Rubric scores</div>
              <div class="rubrics">
                {% for label, value in row.scores %}
                <div class="rubric"><span class="k">{{ label }}</span><span>{{ value }}</span></div>
                {% endfor %}
              </div>
            </div>
            <div>
              <div class="field-label">Judge rationale</div>
              <div class="rationale">{{ row.rationale }}</div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- EXPORT -->
  <section class="view" data-v="export">
    <div class="block">
      <div class="block-h"><span class="eyebrow">Take it with you</span><h2>Export</h2></div>
      <p class="lede">This report is a single self-contained file &#8212; save or share the .html directly. The validation tables are also available as CSV, and the run manifest as JSON.</p>
      <div class="btnrow">
        {% if reliability_csv_href %}<a class="btn" href="{{ reliability_csv_href }}" download="reliability.csv">&#8595; reliability.csv</a>{% endif %}
        {% if high_variance_csv_href %}<a class="btn" href="{{ high_variance_csv_href }}" download="high_variance.csv">&#8595; high_variance.csv</a>{% endif %}
        <button class="btn" id="copyBtn" type="button">&#10697; Copy run manifest (JSON)</button>
      </div>
      <pre class="json" id="manifest" style="display:none">{{ manifest_json }}</pre>
    </div>
  </section>

</main>

<footer>Generated by Lodestar &#183; every aggregate traces to the judged text &#183; self-contained, no server required.</footer>

<script>
  // ---- tabs: one view visible at a time, deep-linkable via #hash ----
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));
  var views = Array.prototype.slice.call(document.querySelectorAll('.view'));
  var viewIds = views.map(function (v) { return v.getAttribute('data-v'); });
  function show(v) {
    if (viewIds.indexOf(v) === -1) v = viewIds[0];
    views.forEach(function (s) { s.classList.toggle('on', s.getAttribute('data-v') === v); });
    tabs.forEach(function (t) { t.classList.toggle('on', t.getAttribute('data-v') === v); });
    try { history.replaceState(null, '', '#' + v); } catch (e) {}
  }
  tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.getAttribute('data-v')); }); });
  show((location.hash || '#overview').slice(1));

  // ---- shared hover tooltip for any [data-tip] element (charts + grid cells) ----
  var tip = document.getElementById('tip');
  document.addEventListener('mouseover', function (e) {
    var target = e.target.closest && e.target.closest('[data-tip]');
    if (!target) return;
    var parts = target.getAttribute('data-tip').split('|');
    tip.querySelector('.l1').innerHTML = parts[0] || '';
    tip.querySelector('.l2').innerHTML = parts[1] || '';
    tip.style.display = 'block';
  });
  document.addEventListener('mousemove', function (e) {
    if (tip.style.display !== 'block') return;
    tip.style.left = Math.min(e.clientX + 14, window.innerWidth - 270) + 'px';
    tip.style.top = Math.max(e.clientY - 10, 8) + 'px';
  });
  document.addEventListener('mouseout', function (e) {
    if (e.target.closest && e.target.closest('[data-tip]')) tip.style.display = 'none';
  });

  // ---- generations: collapsible rows + condition chips + search filter + optional scale filter ----
  var rowsEl = document.getElementById('rows');
  var activeCond = 'all', query = '', scaleFilter = null;
  function applyFilter() {
    var shown = 0;
    rowsEl.querySelectorAll('.row').forEach(function (row) {
      var matchesCond = activeCond === 'all' || row.getAttribute('data-cond') === activeCond;
      var matchesQuery = !query || row.innerText.toLowerCase().includes(query);
      var matchesScale = !scaleFilter || row.getAttribute('data-scale') === scaleFilter;
      var visible = matchesCond && matchesQuery && matchesScale;
      row.classList.toggle('hide', !visible);
      if (visible) shown++;
    });
    var countEl = document.getElementById('count');
    if (countEl) countEl.textContent = shown + ' shown';
    return shown;
  }
  if (rowsEl) {
    rowsEl.querySelectorAll('.row-h').forEach(function (head) {
      head.addEventListener('click', function () { head.closest('.row').classList.toggle('is-open'); });
    });
    document.getElementById('chips').addEventListener('click', function (e) {
      var chip = e.target.closest('.chip');
      if (!chip) return;
      document.querySelectorAll('.chip').forEach(function (c) { c.classList.remove('on'); });
      chip.classList.add('on');
      activeCond = chip.getAttribute('data-c');
      applyFilter();
    });
    document.getElementById('search').addEventListener('input', function (e) {
      query = e.target.value.toLowerCase();
      applyFilter();
    });
  }

  // ---- inspector: clicking a frontier point jumps to Generations, filters to
  // that scale, and opens generations one at a time with Prev/Next ----
  var inspector = document.getElementById('inspector');
  var matchEls = [], matchIndex = 0;
  function focusMatch() {
    matchEls.forEach(function (el) { el.classList.remove('is-open'); });
    var el = matchEls[matchIndex];
    if (!el) return;
    el.classList.add('is-open');
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    document.getElementById('inspectorPos').textContent = (matchIndex + 1) + ' / ' + matchEls.length;
  }
  function openGenerationsAtScale(scale) {
    show('generations');
    scaleFilter = scale;
    activeCond = 'all';
    query = '';
    document.getElementById('search').value = '';
    document.querySelectorAll('.chip').forEach(function (c) { c.classList.toggle('on', c.getAttribute('data-c') === 'all'); });
    applyFilter();
    matchEls = Array.prototype.slice.call(rowsEl.querySelectorAll('.row:not(.hide)'));
    matchIndex = 0;
    inspector.style.display = matchEls.length ? 'flex' : 'none';
    document.getElementById('inspectorLabel').textContent = 'Scale ' + scale;
    focusMatch();
  }
  if (inspector) {
    document.getElementById('inspectorPrev').addEventListener('click', function () {
      if (!matchEls.length) return;
      matchIndex = (matchIndex - 1 + matchEls.length) % matchEls.length;
      focusMatch();
    });
    document.getElementById('inspectorNext').addEventListener('click', function () {
      if (!matchEls.length) return;
      matchIndex = (matchIndex + 1) % matchEls.length;
      focusMatch();
    });
    document.getElementById('inspectorClose').addEventListener('click', function () {
      scaleFilter = null;
      inspector.style.display = 'none';
      applyFilter();
    });
  }

  // ---- click a frontier point: highlight matching rows in every table, then
  // open the inspector on Generations for that scale ----
  document.addEventListener('click', function (e) {
    var point = e.target.closest && e.target.closest('.lodestar-point');
    if (!point) return;
    var scale = point.getAttribute('data-scale');
    document.querySelectorAll('.is-row-highlighted').forEach(function (el) { el.classList.remove('is-row-highlighted'); });
    document.querySelectorAll('.lodestar-point.is-active').forEach(function (el) { el.classList.remove('is-active'); });
    document.querySelectorAll('.lodestar-point[data-scale="' + scale + '"]').forEach(function (el) { el.classList.add('is-active'); });
    document.querySelectorAll('tr[data-scale="' + scale + '"]').forEach(function (el) { el.classList.add('is-row-highlighted'); });
    openGenerationsAtScale(scale);
  });

  // ---- export: copy run manifest JSON to the clipboard ----
  var copyBtn = document.getElementById('copyBtn');
  if (copyBtn) copyBtn.addEventListener('click', function () {
    var text = document.getElementById('manifest').textContent;
    var done = function () {
      var original = '&#10697; Copy run manifest (JSON)';
      copyBtn.textContent = '✓ Copied';
      setTimeout(function () { copyBtn.innerHTML = original; }, 1500);
    };
    if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, done);
    else done();
  });
</script>
</body>
</html>
